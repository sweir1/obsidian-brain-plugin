{
  "name": "obsidian-brain-companion",
  "version": "1.8.1",
  "description": "Obsidian plugin that exposes live runtime state (active editor, Dataview, Bases) to the obsidian-brain MCP server over a localhost HTTP endpoint.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc -p .",
    "build": "tsc -p . && node esbuild.config.mjs production",
    "test": "vitest run"
  },
  "keywords": [
    "obsidian-plugin",
    "mcp",
    "dataview",
    "obsidian-brain"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",
    "yaml": "^2.9.1"
  }
}

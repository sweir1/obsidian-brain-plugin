{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2018",
    "lib": ["DOM", "ES2018"],
    "types": ["node"],
    "noEmit": true,
    "allowJs": true,
    "strict": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "importHelpers": true,
    "allowSyntheticDefaultImports": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
